{
  "manifest_version": 3,
  "name": "Aria2 Download Manager",
  "version": "1.0.0",
  "description": "Intercepts browser downloads and forwards them to aria2c for multi-threaded downloading",
  "permissions": [
    "downloads",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "options_page": "options.html"
}
